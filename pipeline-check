#!/usr/bin/env bash
# pipeline-check - verify every project is actually going through the
# pipeline: versioned, pushed, CI green, and (for services) deployed at
# HEAD. SELF-HEALING edition: attempts a fix for each alert, re-checks,
# and only reports what is STILL broken after the fix attempt.
# Persistent alerts are deduped for 6h (state in ~/.pipeline-check.state).
# Prints nothing when everything is green AND stays green.
#
# Every self-heal is recorded to ~/.local/state/pipeline-check/status.json
# (event-driven, bounded 50-entry ledger) so the portal's Self-healing
# panel and pi-doctor's audit can show the self-healer's work.
#
# Manual use:   pipeline-check [--verbose]
set -u
set +o pipefail
VERBOSE=no
[ "${1:-}" = "--verbose" ] && VERBOSE=yes

HOME_DIR="${GUARD_HOME:-/home/ev}"
EXCLUDE=(AIS-catcher-src AdGuardHome)
STATE_FILE="$HOME_DIR/.pipeline-check.state"
DEDUPE_HOURS=6
HEAL_STATE_DIR="$HOME_DIR/.local/state/pipeline-check"
HEALS_FILE="$HEAL_STATE_DIR/status.json"
# Services with pull-based CD: dir -> systemd unit of the deploy timer
declare -A SERVICES=(
    [maritime-dashboard]=maritime-dashboard-deploy
    [project-hub]=project-hub-deploy
    [sat-audio]=sat-audio-deploy
    [book-app]=book-app-deploy
    [shelfmate]=shelfmate-deploy
)

alerts=0
report=""
alertlines=""
fixedlines=""

note()  { report+="$1"$'\n'; }          # verbose-only line
alert() { alertlines+="⚠ $1"$'\n'; alerts=$((alerts+1)); }

# ---------- heal ledger: every self-heal, with before -> after detail ----
record_heal() {  # $1=machine key, $2=human detail line
    mkdir -p "$HEAL_STATE_DIR"
    python3 - "$HEALS_FILE" "$1" "$2" <<'PY'
import json, os, sys, datetime
path, what, detail = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, ValueError):
    data = {"heals": []}
entry = {"ts": datetime.datetime.now().isoformat(timespec="seconds"),
         "what": what, "detail": detail}
data.setdefault("heals", []).append(entry)
data["heals"] = data["heals"][-50:]  # keep the ledger bounded
data["updated"] = entry["ts"]
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
os.replace(tmp, path)
PY
}

fixed() {  # $1=machine key, $2=human line
    fixedlines+="✓ $2"$'\n'
    record_heal "$1" "$2"
}

# ---------- dedupe state: suppress alerts seen in the last N hours ------
state_key() { echo "$1" | tr ' /:' '__' | cut -c1-80; }
seen_recently() {
    local key ts now
    key=$(state_key "$1")
    ts=$(grep -F "$key=" "$STATE_FILE" 2>/dev/null | tail -1 | cut -d= -f2)
    [ -z "$ts" ] && return 1
    now=$(date +%s)
    [ $((now - ts)) -lt $((DEDUPE_HOURS * 3600)) ]
}
mark_seen() {
    local key
    key=$(state_key "$1")
    touch "$STATE_FILE"
    sed -i "/^$key=/d" "$STATE_FILE" 2>/dev/null
    echo "$key=$(date +%s)" >> "$STATE_FILE"
}

# ---------- self-heal helpers -------------------------------------------

# Re-run a failed GitHub Actions workflow once (flaky-run recovery).
retry_run() {
    local slug=$1 runid
    runid=$(gh run list -R "$slug" --limit 1 --json databaseId,conclusion \
            -q '.[0] | select(.conclusion=="failure") | .databaseId' 2>/dev/null)
    [ -z "$runid" ] && return 1
    gh run rerun "$runid" -R "$slug" >/dev/null 2>&1 || return 1
    echo "re-run queued"
}

# A repo whose newest run failed BEFORE its newest push: the failure is
# stale (a newer commit already landed). Fetch + wait for the new run.
stale_failure() {
    local slug=$1 head lastrunsha
    head=$(git -C "$2" rev-parse HEAD 2>/dev/null)
    lastrunsha=$(gh run list -R "$slug" --limit 1 --json headSha \
                 -q '.[0].headSha' 2>/dev/null)
    [ -n "$head" ] && [ "$lastrunsha" != "$head" ]
}

is_project_dir() {
    find "$1" -maxdepth 2 -not -path '*/.git*' -not -path '*/lib/*' \
         -not -path '*/bin/*' -not -path '*/include/*' -not -path '*/node_modules/*' \
         \( -name '*.py' -o -name '*.js' -o -name '*.sh' -o -name package.json \
            -o -name Makefile -o -name '*.cpp' -o -name '*.c' \) -print -quit 2>/dev/null \
      | grep -q .
}

excluded() {
    local name; name=$(basename "$1")
    for e in "${EXCLUDE[@]}"; do [ "$name" = "$e" ] && return 0; done
    return 1
}

check_project() {
    local dir=$1 name; name=$(basename "$1")

    if [ ! -d "$dir/.git" ]; then
        is_project_dir "$dir" && alert "$name: code present but NOT a git repo (guard should adopt within 10 min)"
        return
    fi
    git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1 || {
        note "  $name: repo has no commits yet - skipped"
        return
    }

    local origin_url
    origin_url=$(git -C "$dir" remote get-url origin 2>/dev/null) || {
        alert "$name: NO GitHub remote - work exists only on this Pi"
        return
    }

    git -C "$dir" fetch -q origin 2>/dev/null || note "  $name: fetch failed (offline?)"

    local branch
    branch=$(git -C "$dir" branch --show-current 2>/dev/null)
    if [ -n "$branch" ]; then
        local ahead
        ahead=$(git -C "$dir" rev-list --count "origin/$branch..$branch" 2>/dev/null || echo "?")
        if [ "$ahead" != "0" ]; then
            # SELF-HEAL: push the commits ourselves
            if git -C "$dir" push origin "$branch" >/dev/null 2>&1; then
                fixed push-stranded-commits "$name: pushed $ahead stranded commit(s) to $branch"
            else
                alert "$name: $ahead unpushed commit(s) on $branch (push failed - auth or conflict?)"
            fi
        fi
        local dirty
        dirty=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l)
        note "  $name: $branch, $dirty uncommitted path(s) (autosave covers these)"
    else
        note "  $name: detached HEAD (deploy rollback window?)"
    fi

    # CI verdict for the newest commit that has runs
    local slug
    slug=$(echo "$origin_url" | sed -n 's#.*github\.com[:/]##; s#\.git$##p')
    if [ -n "$slug" ]; then
        local verdict concl status sha
        verdict=$(gh run list -R "$slug" --limit 1 --json conclusion,status,headSha \
                    -q '.[0] | "\(.conclusion) \(.status) \(.headSha[0:8])"' 2>/dev/null)
        concl=${verdict%% *}; rest=${verdict#* }; status=${rest%% *}; sha=${rest#* }
        case "$concl" in
            success) note "  $name: CI green ($verdict)" ;;
            failure|startup_failure|cancelled|timed_out|action_required)
                if stale_failure "$slug" "$dir"; then
                    # SELF-HEAL: failure is on an old commit; a newer one is
                    # already landing. Just note it; next check sees the new run.
                    note "  $name: CI failure on $sha is stale (newer HEAD pushed; waiting for new run)"
                elif [ "$concl" = "failure" ]; then
                    # SELF-HEAL attempt: one re-run covers network flakes.
                    # Real code bugs will fail again -> alert (deduped 6h).
                    if retry_run "$slug" >/dev/null 2>&1; then
                        fixed ci-rerun-queued "$name: CI failure on $sha — re-run queued (flake?)"
                    elif seen_recently "ci:$name:$sha"; then
                        note "  $name: CI failure on $sha (already reported; fix in progress)"
                    else
                        mark_seen "ci:$name:$sha"
                        alert "$name: CI failure on $sha persists after re-run — needs a code fix"
                    fi
                else
                    alert "$name: CI $concl on $sha"
                fi ;;
            *)  # null/empty: either pending or no runs at all
                if [ "$sha" = "null" ] || [ -z "$sha" ]; then
                    if ls "$dir"/.github/workflows/*.yml >/dev/null 2>&1; then
                        note "  $name: CI configured but no runs yet"
                    elif is_project_dir "$dir"; then
                        alert "$name: has code but no CI workflow - not going through the pipeline"
                    else
                        note "  $name: docs-only so far, CI added when code arrives"
                    fi
                else
                    note "  $name: CI $status ($sha)"
                fi ;;
        esac
    fi

    # Service deploy freshness
    if [ -n "${SERVICES[$name]:-}" ]; then
        local timer marker head m8
        timer="${SERVICES[$name]}"
        if ! systemctl is-active --quiet "$timer.timer"; then
            # SELF-HEAL: re-enable the deploy timer
            if sudo -n systemctl enable --now "$timer.timer" >/dev/null 2>&1; then
                fixed re-enable-deploy-timer "$name: deploy timer $timer.timer re-enabled"
            else
                alert "$name: deploy timer $timer.timer NOT active (enable failed)"
            fi
        fi
        marker=$(cat "$dir/.deployed_commit" 2>/dev/null || echo "")
        head=$(git -C "$dir" rev-parse HEAD)
        m8=${marker:0:8}; [ -z "$m8" ] && m8="nothing-yet"
        if [ "$marker" != "$head" ]; then
            # SELF-HEAL: run the deploy now
            if [ -x "$dir/deploy/deploy.sh" ]; then
                if (cd "$dir" && ./deploy/deploy.sh >/dev/null 2>&1); then
                    newmarker=$(cat "$dir/.deployed_commit" 2>/dev/null || echo "")
                    if [ "$newmarker" = "$head" ]; then
                        fixed deploy-caught-up "$name: deploy caught up ($m8 -> ${head:0:8})"
                    else
                        alert "$name: deploy re-run did not reach HEAD (health gate? see deploy.log)"
                    fi
                else
                    alert "$name: deploy re-run failed (see deploy.log)"
                fi
            else
                alert "$name: service runs $m8, HEAD is ${head:0:8} (no deploy.sh to self-heal)"
            fi
        else
            note "  $name: deployed at HEAD, healthy"
        fi
    fi
}

for d in "$HOME_DIR"/*/ "$HOME_DIR"/apps/*/; do
    [ -d "$d" ] || continue
    b=$(basename "$d"); case "$b" in .*) continue;; esac
    excluded "$d" && continue
    [ "$d" = "$HOME_DIR/apps/" ] && continue
    [ -f "$d/pyvenv.cfg" ] && [ ! -d "$d/.git" ] && continue
    check_project "$d"
done

if [ "$VERBOSE" = yes ]; then
    printf '%s' "$report"
    [ -n "$fixedlines" ] && { echo "Self-healed:"; printf '%s' "$fixedlines"; }
    printf '%s' "$alertlines"
    [ $alerts = 0 ] && echo "✓ all projects pipeline-clean"
elif [ $alerts -gt 0 ]; then
    printf '%s' "$alertlines"
    echo "$alerts pipeline issue(s) persist after self-heal attempts"
elif [ -n "$fixedlines" ]; then
    # silent success: fixes happened, nothing needs the human
    :
fi
exit 0
