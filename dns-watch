#!/usr/bin/env python3
"""dns-watch — run [dns-check] on a timer, page once per state change.

The 2026-11-16 outage (docs/incidents/2026-11-16-dns-outage.md) was
discovered the hard way: Hermes failed to reach a model provider at
23:35, and nothing on the box had said "name resolution is dead".
`dns-check` was written that morning — a read-only verdict that names
which half broke and prints the recovery commands — but a tool nobody
runs at 23:35 is a tool that reports nothing.

dns-watch is the timer half. Each run:

  1. executes `dns-check` once, verbatim, at its own exit code;
  2. compares that verdict with the last one recorded in its state file;
  3. publishes **one** ntfy message when the verdict *changes*, and
     nothing at all while it stays the same;
  4. appends one line to the page ledger for each page it actually
     publishes — the timestamp, verdict, exit code and whether the probe's
     retry was used — so a night of flapping is a countable list instead of
     a `pages` counter;
  5. appends one line to the *fallback* ledger for each run that reached
     its OK through a second endpoint, naming the endpoint that failed —
     because that run changes nothing else: the verdict may be identical, so
     there is no page and no page-ledger line, and without this record the
     fallback leaves no trace anywhere.
  6. counts the *run* of consecutive fallbacks to the same endpoint in the
     state file, and pages **once** when it reaches `FALLBACK_STREAK_PAGES_AT`
     (default 3) — one dead endpoint covered by a live one is not news, a
     week of it is. The streak resets on any run that did not fall back, so
     a repair clears it without anyone touching the state.

Edge-triggered on purpose (the 2026-08-30 lesson, metric-alert's shape):
a standing failure must not page every hour, and a recovery must not be
silent.

    dns-watch [--config FILE] [--state FILE] [--ledger FILE] [--dry-run] [-v]
    dns-watch --history [--state FILE] [--ledger FILE]
    dns-watch --stale [--stale-after HOURS] [--state FILE]

Verdict states: healthy | dns | egress | both | probe-error, mapped from
dns-check's own codes (0/1/2/3; anything else — a missing interpreter, a
kill — is probe-error, named with the rc).

Every run that saves state stamps `checked_at`, so the age of the newest
run is a fact on disk even when nothing paged — the two readers that make
it visible without a ledger line:

  * `--history` prints `newest run: <stamp> (<age> ago)` above the page
    lines (exit 0 as before, writes nothing);
  * `--stale` (limit from `STALE_AFTER_HOURS`, default 2 h) prints one
    line and exits 0 fresh / 1 STALE / 2 unmeasurable — a missing or
    unreadable state file names its path rather than reading as fresh,
    because "cannot measure" is not a pass. It runs no probe and writes
    nothing, so the morning audit can call it cheaply.

Exit codes: dns-check's verdict passes through unchanged (0 healthy,
1 resolution broken, 2 egress broken, 3 both), and **4** when the probe
itself could not run. A failing unit is a record the daily pi-doctor
audit names; the page is the fast path.

The probe stays read-only. dns-watch's only writes are its own state file
(`~/.local/state/dns-watch/state.json`, temp file + atomic rename), its
page ledger (`pages.log` beside the state file, one line per *page*, so a
flapping night is countable: `--history` prints the last 24 h) and its
fallback ledger (`fallbacks.log` beside the page ledger, one line per run
that used a second endpoint — `--history` prints those lines and their
count after the page count), and `--dry-run` does not even do those. Config
(optional, /etc/dns-watch.conf,
KEY=VALUE, `#` comments, last occurrence wins — parse_env_lists' rule):

    NTFY_URL=http://127.0.0.1:6839
    NTFY_TOKEN=replace-me
    NTFY_TOPIC=services          # existing provisioned topic
    STATE=~/.local/state/dns-watch/state.json
    LEDGER=~/.local/state/dns-watch/pages.log   # default: beside STATE
    LEDGER_MAX_LINES=2000        # past this, pages.log -> pages.log.1
    FALLBACK_STREAK_PAGES_AT=3   # page once when this many fallbacks in a row
    STALE_AFTER_HOURS=2          # --stale's limit (hourly timer: 2 misses)
    DNS_CHECK=dns-check          # absolute path if not on PATH
    TIMEOUT_SECS=15              # publish timeout, never unbounded
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

import ntfy_lib

DEFAULT_CONFIG = "/etc/dns-watch.conf"
DEFAULT_STATE = "~/.local/state/dns-watch/state.json"
DEFAULT_TOPIC = "services"
DEFAULT_DNS_CHECK = "dns-check"
DEFAULT_TIMEOUT = 15
PROBE_TIMEOUT = 120

#: The ledger's default name, resolved beside the state file (one directory,
#: one fact — an operator moving STATE takes the ledger along).
LEDGER_NAME = "pages.log"
#: The fallback ledger's name, resolved beside the page ledger for the same
#: reason: a fallback leaves no page, so without a line of its own it leaves
#: no record at all.
FALLBACKS_NAME = "fallbacks.log"
DEFAULT_LEDGER_MAX = 2000
HISTORY_HOURS = 24

#: How many consecutive fallbacks to the same endpoint before the phone hears
#: about it. One is a route flap; three hourly runs is nearly a whole working
#: day of "the primary is dead and something is covering for it".
DEFAULT_STREAK_PAGES_AT = 3
#: The page ledger's verdict column for the streak page — a page that is not
#: a verdict change, so it must not read like one.
STREAK_LEDGER_WORD = "fallback-streak"

#: `--stale`'s default limit. The timer fires hourly, so two hours without a
#: run means a fire was missed (a reboot, a masked timer, a dead manager).
DEFAULT_STALE_AFTER = 2.0

#: dns-check's own retry note (`dns-check`, the IP egress line). Duplicated
#: in another language on purpose: a test drives the real probe through a
#: server that stalls its first attempt, so if that wording drifts the
#: ledger's `retry=` column goes red instead of quietly reading `no`.
RETRY_MARKER = "(retry; first attempt failed)"

#: dns-check's fallback note — the endpoints that failed, named inside it.
#: A fallback is the one success that pages nothing (the verdict did not
#: change), so this line is the only place it can be recorded; a drift in
#: dns-check's wording reddens the fallback tests rather than silencing it.
FALLBACK_PREFIX = "(fallback; "
FALLBACK_SUFFIX = " failed first)"

#: dns-check's own contract, spelled where the mapping is built.
VERDICTS = {
    0: ("healthy", "healthy", "IP path and name resolution both work"),
    1: ("dns", "DNS BROKEN", "packets leave the box, names do not resolve"),
    2: ("egress", "EGRESS BROKEN", "names resolve but the raw-IP probe fails"),
    3: ("both", "NO EGRESS", "both the IP path and name resolution failed"),
}
PROBE_ERROR = "probe-error"
BROKEN = ("dns", "egress", "both", PROBE_ERROR)

TAGS = {
    "healthy": ["white_check_mark"],
    "dns": ["warning", "dns"],
    "egress": ["warning", "dns"],
    "both": ["rotating_light", "dns"],
    PROBE_ERROR: ["warning", "dns"],
}


# ---------------------------------------------------------------- config

def parse_env_lists(path):
    """KEY=VALUE lines -> dict, last occurrence wins (repeated keys accumulate
    in the source order, and the board's own configs rely on the LAST one)."""
    cfg = {}
    try:
        text = Path(path).read_text(encoding="utf-8")
    except OSError:
        return cfg
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        cfg[key.strip()] = value.strip()
    return cfg


def load_config(path):
    cfg = parse_env_lists(path)
    return {
        "ntfy_url": cfg.get("NTFY_URL", ""),
        "ntfy_token": cfg.get("NTFY_TOKEN", ""),
        "topic": cfg.get("NTFY_TOPIC") or DEFAULT_TOPIC,
        "state": os.path.expanduser(cfg.get("STATE") or DEFAULT_STATE),
        "ledger": os.path.expanduser(cfg.get("LEDGER") or ""),
        "ledger_max": _count(cfg.get("LEDGER_MAX_LINES"), DEFAULT_LEDGER_MAX),
        "streak_pages_at": _count(cfg.get("FALLBACK_STREAK_PAGES_AT"),
                                  DEFAULT_STREAK_PAGES_AT),
        "stale_after": _number(cfg.get("STALE_AFTER_HOURS"),
                               DEFAULT_STALE_AFTER),
        "dns_check": cfg.get("DNS_CHECK") or DEFAULT_DNS_CHECK,
        "timeout": _number(cfg.get("TIMEOUT_SECS"), DEFAULT_TIMEOUT),
    }


def _number(value, default):
    try:
        number = float(value)
    except (TypeError, ValueError):
        return default
    return number if number > 0 else default


def _count(value, default):
    """A positive whole number of lines, or the default (named, not silent)."""
    try:
        number = int(str(value).strip())
    except (TypeError, ValueError):
        return default
    return number if number > 0 else default


def _hours(value):
    """argparse type for --stale-after: a positive number of hours."""
    try:
        number = float(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError(f"not a number: {value!r}") from None
    if number <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return number


# ----------------------------------------------------------------- state

def load_state(path):
    """state.json -> dict; missing or corrupt -> {} with a named warning."""
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except OSError:
        return {}
    except ValueError:
        print(f"dns-watch: state file corrupt at {path} — starting fresh",
              file=sys.stderr)
        return {}
    return data if isinstance(data, dict) else {}


def save_state(path, state):
    """Atomic write (temp file + rename). False on failure, named."""
    p = Path(path)
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_name(p.name + ".tmp")
        tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n",
                       encoding="utf-8")
        tmp.replace(p)
        return True
    except OSError as exc:
        print(f"dns-watch: cannot write {path}: {exc}", file=sys.stderr)
        return False


# ---------------------------------------------------------------- ledger

def ledger_path(cfg, state_path, explicit=None):
    """--ledger, then config LEDGER, then `pages.log` beside the state file."""
    if explicit:
        return os.path.expanduser(explicit)
    if cfg.get("ledger"):
        return cfg["ledger"]
    return str(Path(state_path).with_name(LEDGER_NAME))


def ledger_line(now, state_word, rc, retry):
    """One page, one line: when, what, at which exit code, retried or not."""
    return "{ts}  {state:<11}  rc={rc:<3}  retry={retry}".format(
        ts=now.isoformat(timespec="seconds"), state=state_word,
        rc="-" if rc is None else rc, retry=retry)


def retry_used(output):
    """Did dns-check reach its OK on the retry? (`no` when it says nothing.)"""
    return "yes" if RETRY_MARKER in output else "no"


def fallback_endpoints(output):
    """The endpoints dns-check named as failed, from its fallback note.

    `[]` when this run reached its OK on the first endpoint — the plain case
    — or when the note is absent, so the recorder stays silent for it.
    """
    for line in output.splitlines():
        start = line.find(FALLBACK_PREFIX)
        if start < 0:
            continue
        rest = line[start + len(FALLBACK_PREFIX):]
        stop = rest.find(FALLBACK_SUFFIX)
        if stop < 0:
            continue
        named = rest[:stop].split()
        if named:
            return named
    return []


def answered_endpoint(output):
    """The endpoint dns-check's IP egress line says answered, or ""."""
    for line in output.splitlines():
        if "IP egress" not in line:
            continue
        start = line.find("(")
        stop = line.find(",", start + 1)
        if 0 <= start < stop:
            return line[start + 1:stop].strip()
    return ""


def fallback_path(ledger_file):
    """The fallback ledger lives beside the page ledger: one directory, one
    fact, so `--ledger` moves both and nothing can drift apart."""
    return str(Path(ledger_file).with_name(FALLBACKS_NAME))


def fallback_line(now, failed, answered):
    """One fallback, one line: when, which endpoint(s) failed, which answered.

    The marker word `fallback` sits in the verdict column's place, so a
    reader of either file can tell the two kinds apart by one field.
    """
    return "{ts}  {mark:<11}  failed={failed}  answered={answered}".format(
        ts=now.isoformat(timespec="seconds"), mark="fallback",
        failed=",".join(failed) or "?", answered=answered or "?")


def parse_fallback_line(line):
    """-> (stamp, failed, answered) or (None,) when the line is not ours."""
    parts = line.split()
    if len(parts) != 4 or parts[1] != "fallback" \
            or not parts[2].startswith("failed=") \
            or not parts[3].startswith("answered="):
        return (None,)
    try:
        stamp = datetime.fromisoformat(parts[0])
    except ValueError:
        return (None,)
    if stamp.tzinfo is None:                 # a hand-edited line: read as UTC
        stamp = stamp.replace(tzinfo=timezone.utc)
    return (stamp, parts[2][len("failed="):], parts[3][len("answered="):])


def streak_key(failed):
    """The endpoint set a fallback run named, as one comparable string."""
    return ",".join(failed)


def next_streak(previous, key, now):
    """-> the state's `fallback_streak` after this run.

    A run that fell back to the same endpoint set extends the run; a run on a
    different set starts a new one; a run that reached its OK with no fallback
    at all clears it — which is what makes a repair reset the count without
    anyone editing state by hand.
    """
    prev = previous if isinstance(previous, dict) else {}
    if not key:
        return {"failed": "", "runs": 0, "since": None, "paged": False}
    stamp = now.isoformat(timespec="seconds")
    if prev.get("failed") == key:
        try:
            runs = int(prev.get("runs", 0)) + 1
        except (TypeError, ValueError):
            runs = 1
        return {"failed": key, "runs": runs, "since": prev.get("since") or stamp,
                "paged": bool(prev.get("paged"))}
    return {"failed": key, "runs": 1, "since": stamp, "paged": False}


def read_streak(state_path):
    """The state's fallback streak, or {} when the file or the key is absent."""
    try:
        data = json.loads(Path(state_path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    streak = data.get("fallback_streak")
    return streak if isinstance(streak, dict) else {}


def streak_summary(streak):
    """One clause for `--history`: the current run of fallbacks, or its absence.

    Read from the state, not from the ledger's tail: a run that reaches its OK
    with no fallback writes no ledger line, so only the state knows the run
    ended.
    """
    try:
        runs = int(streak.get("runs", 0))
    except (TypeError, ValueError):
        runs = 0
    key = streak.get("failed") or ""
    if runs < 1 or not key:
        return "streak: none — the newest run used no fallback"
    clause = f"streak: {key} failed on {runs} consecutive run(s)"
    if streak.get("since"):
        clause += f", since {streak['since']}"
    if streak.get("paged"):
        clause += " (paged)"
    return clause


def build_streak_message(key, answered, runs, since):
    """The one page a run of fallbacks earns: the endpoint, the count, why now."""
    lines = [
        f"dns-watch: {key} failed on {runs} consecutive runs — the OK is still "
        "being reached through a later endpoint, so nothing paged until now.",
        "",
        f"Failing endpoint: {key}",
        f"Answering endpoint: {answered or 'not named'}",
    ]
    if since:
        lines.append(f"Streak started {since}.")
    lines.append("Paged once per streak — it stays quiet until a run reaches "
                 "its OK through no fallback.")
    return "\n".join(lines)


def read_ledger(path):
    """Ledger lines, oldest first; a missing file is an empty ledger."""
    try:
        text = Path(path).read_text(encoding="utf-8")
    except OSError:
        return []
    return [line.rstrip() for line in text.splitlines() if line.strip()]


def append_ledger(path, line, cap):
    """Append one line, rotating to `<name>.1` when appending would pass the
    cap. -> (ok, rotated)

    Rotation keeps exactly one previous generation, so the pair on disk is
    bounded at 2*cap lines and the file never grows without limit; `--history`
    reads both generations, so a rotation mid-window loses nothing.
    """
    p = Path(path)
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        rotated = False
        if len(read_ledger(p)) + 1 > cap:
            p.replace(p.with_name(p.name + ".1"))
            rotated = True
        with open(p, "a", encoding="utf-8") as handle:
            handle.write(line + "\n")
        return True, rotated
    except OSError as exc:
        print(f"dns-watch: cannot write ledger {path}: {exc}", file=sys.stderr)
        return False, False


def parse_ledger_line(line):
    """-> (stamp, verdict, rc, retry) or (None,) when the line is not ours."""
    parts = line.split()
    if len(parts) < 4 or not parts[2].startswith("rc=") \
            or not parts[3].startswith("retry="):
        return (None,)
    try:
        stamp = datetime.fromisoformat(parts[0])
    except ValueError:
        return (None,)
    if stamp.tzinfo is None:                 # a hand-edited line: read as UTC
        stamp = stamp.replace(tzinfo=timezone.utc)
    return (stamp, parts[1], parts[2][3:], parts[3][6:])


def newest_run(state_path):
    """The state file's own run stamp. -> (stamp, None) or (None, reason).

    Every run that saves state writes `checked_at`, so this is the one fact
    that only advances when the timer actually fires — the ledger records
    pages, and a quiet night is byte-identical to a dead timer's.
    """
    path = Path(state_path)
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return None, (f"no readable state file at {state_path} "
                      f"({exc.strerror or exc})")
    try:
        data = json.loads(text)
    except ValueError:
        return None, f"state file at {state_path} is not JSON"
    if not isinstance(data, dict):
        return None, f"state file at {state_path} is not an object"
    stamped = data.get("checked_at")
    if not stamped:
        return None, f"state file at {state_path} carries no checked_at"
    try:
        stamp = datetime.fromisoformat(str(stamped))
    except ValueError:
        return None, (f"state file at {state_path} carries an unparseable "
                      f"checked_at {stamped!r}")
    if stamp.tzinfo is None:                 # a hand-edited file: read as UTC
        stamp = stamp.replace(tzinfo=timezone.utc)
    return stamp, None


def format_age(stamp, now):
    """`0.4 h ago` — signed, so a clock that stepped back is visible."""
    return f"{(now - stamp).total_seconds() / 3600.0:.1f} h ago"


def stale_verdict(state_path, limit_hours, now=None):
    """One line, one exit code: 0 fresh, 1 STALE, 2 unmeasurable. Writes
    nothing and runs no probe (feed-fresh's contract, same family)."""
    now = now or datetime.now(timezone.utc)
    stamp, reason = newest_run(state_path)
    if stamp is None:
        print(f"dns-watch: UNMEASURABLE — {reason}", file=sys.stderr)
        return 2
    age = format_age(stamp, now)
    if (now - stamp).total_seconds() / 3600.0 >= limit_hours:
        print(f"dns-watch: STALE — newest run {age}, limit "
              f"{limit_hours:g} h ({state_path})", file=sys.stderr)
        return 1
    print(f"dns-watch: OK — newest run {age}, limit {limit_hours:g} h")
    return 0


def print_history(path, state_path=None, now=None, hours=HISTORY_HOURS,
                  fallbacks_file=None):
    """`--history`: the last `hours` of pages *and* fallbacks, one line each,
    oldest first, then one count per kind. Writes nothing."""
    now = now or datetime.now(timezone.utc)
    window = now - timedelta(hours=hours)
    print(f"dns-watch page ledger — {now.isoformat(timespec='seconds')} "
          f"(last {hours} h, since {window.isoformat(timespec='seconds')})")
    if state_path is not None:
        stamp, reason = newest_run(state_path)
        if stamp is None:
            print(f"newest run: none — {reason}")
        else:
            print(f"newest run: {stamp.isoformat(timespec='seconds')} "
                  f"({format_age(stamp, now)})")
    entries = []
    lines = read_ledger(str(path) + ".1") + read_ledger(path)
    shown = unreadable = 0
    for line in lines:
        parsed = parse_ledger_line(line)
        if parsed[0] is None:
            unreadable += 1
            continue
        if parsed[0] < window:
            continue
        entries.append((parsed[0], line))
        shown += 1
    fallback_shown = fallback_unreadable = fallback_total = 0
    if fallbacks_file is not None:
        fb_lines = (read_ledger(str(fallbacks_file) + ".1")
                    + read_ledger(fallbacks_file))
        fallback_total = len(fb_lines)
        for line in fb_lines:
            parsed = parse_fallback_line(line)
            if parsed[0] is None:
                fallback_unreadable += 1
                continue
            if parsed[0] < window:
                continue
            entries.append((parsed[0], line))
            fallback_shown += 1
    for _, line in sorted(entries, key=lambda entry: entry[0]):
        print(line)
    summary = (f"{shown} page(s) in the last {hours} h — {len(lines)} "
               f"line(s) in {path}")
    if unreadable:
        summary += f", {unreadable} unreadable line(s) skipped"
    print(summary)
    if fallbacks_file is not None:
        fb_summary = (f"{fallback_shown} fallback(s) in the last {hours} h — "
                      f"{fallback_total} line(s) in {fallbacks_file}")
        if fallback_unreadable:
            fb_summary += (f", {fallback_unreadable} unreadable line(s) "
                           f"skipped")
        if state_path is not None:
            fb_summary += f"; {streak_summary(read_streak(state_path))}"
        print(fb_summary)
    return 0


# ----------------------------------------------------------------- probe

def resolve_probe(configured):
    """Find dns-check: an explicit config value first (verbatim when it
    carries a path separator), then PATH, then the copy that ships beside
    this script — the repo is the source both symlinks point at, so a test
    (or a fresh checkout) runs even when nothing is installed on PATH.
    """
    if configured and os.sep in configured:
        return configured
    wanted = configured or DEFAULT_DNS_CHECK
    found = shutil.which(wanted)
    if found:
        return found
    sibling = Path(__file__).resolve().parent / wanted
    if sibling.is_file():
        return str(sibling)
    return wanted


def run_probe(command):
    """Execute dns-check once. -> (rc or None, combined output)."""
    try:
        proc = subprocess.run([command], stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, text=True,
                              timeout=PROBE_TIMEOUT, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, f"dns-check could not run: {exc}"
    return proc.returncode, proc.stdout or ""


def classify(rc, output):
    """dns-check's exit code -> (state, title, detail)."""
    if rc in VERDICTS:
        return VERDICTS[rc]
    return (PROBE_ERROR, "DNS WATCH PROBE ERROR",
            f"dns-check exited {rc!r} — the probe itself did not complete")


# ------------------------------------------------------------------ page

def headline(output):
    """The probe's own VERDICT line, when it printed one."""
    for line in reversed(output.splitlines()):
        if "VERDICT" in line:
            return line.strip()
    return ""


def build_message(state, title, detail, output, since=None):
    lines = [f"dns-watch: {title} — {detail}."]
    if state == "healthy":
        if since:
            lines.append(f"Back to healthy after {since}.")
        lines.append("The next page comes only on the next change.")
    else:
        lines.append("Paged once per state change — this will stay quiet "
                     "until it changes.")
    verdict = headline(output)
    if verdict:
        lines.append("")
        lines.append(verdict)
    body = output.strip()
    if body and body != verdict:
        lines.append("")
        lines.append(body)
    message = "\n".join(lines)
    return message if len(message) <= 3500 else message[:3490] + "\n…"


def page(cfg, title, message, tags, dry_run=False):
    """Publish via the shared ntfy_lib; True on any 2xx or muted."""
    if dry_run:
        print(f"dns-watch: would page {title!r} (dry run)")
        return True
    if not (cfg["ntfy_url"] and cfg["ntfy_token"]):
        print("dns-watch: NTFY_URL/NTFY_TOKEN not configured — "
              "page not published", file=sys.stderr)
        return False
    payload = {"topic": cfg["topic"], "message": message, "title": title,
               "tags": tags}
    return ntfy_lib.publish(
        cfg["ntfy_url"], {"Authorization": f"Bearer {cfg['ntfy_token']}"},
        payload, timeout=cfg["timeout"], _urlopen=urllib.request.urlopen)


# ------------------------------------------------------------------ core

def decide(prev, state):
    """Should this run page? (bool, reason)

    First run: silent when healthy (a fresh install on a working box is
    not news), a page when broken (the operator just learned). After
    that: page exactly on a change, recovery included.
    """
    if prev is None:
        return state != "healthy", "first run"
    if prev == state:
        return False, "unchanged"
    return True, f"{prev} -> {state}"


def run(cfg, state_path, dry_run=False, verbose=False, now=None,
        ledger_file=None, fallback_file=None):
    now = now or datetime.now(timezone.utc)
    ledger_file = ledger_file or ledger_path(cfg, state_path)
    fallback_file = fallback_file or fallback_path(ledger_file)
    probe = resolve_probe(cfg["dns_check"])
    rc, output = run_probe(probe)
    state_word, title, detail = classify(rc, output)

    if verbose:
        print(f"dns-watch: probe {probe} rc={rc} -> {state_word}",
              file=sys.stderr)
    if output.strip():
        print(output.rstrip())

    previous = load_state(state_path)
    prev = previous.get("status")
    should, reason = decide(prev, state_word)

    # A fallback changes no verdict, so its run of repeats lives in the state:
    # the ledger's tail cannot tell a streak from a run that ended (a direct
    # OK writes no line), and "the same endpoint, three hours running" is the
    # finding the phone should hear once.
    failed = fallback_endpoints(output)
    answered = answered_endpoint(output)
    streak = next_streak(previous.get("fallback_streak"),
                         streak_key(failed), now)
    streak_should = (streak["runs"] >= cfg["streak_pages_at"]
                     and not streak["paged"])

    since = previous.get("since")
    if prev != state_word:
        since = now.isoformat(timespec="seconds")

    record = {
        "status": state_word,
        "exit_code": rc,
        "since": since,
        "checked_at": now.isoformat(timespec="seconds"),
        "pages": int(previous.get("pages", 0)) + (1 if should else 0),
        "fallback_streak": streak,
    }

    paged = False
    if should:
        message = build_message(state_word, title, detail, output,
                                since=previous.get("since"))
        paged = page(cfg, f"dns-watch: {title}", message,
                     TAGS.get(state_word, []), dry_run=dry_run)
        if not paged:
            # The page is the fast path; the verdict still stands, and the
            # journal keeps the line. Do not pretend the page landed.
            record["pages"] -= 1
    streak_paged = False
    if streak_should:
        streak_title = (f"dns-watch: fallback streak — {streak['failed']} "
                        f"failed {streak['runs']} run(s) in a row")
        streak_paged = page(
            cfg, streak_title,
            build_streak_message(streak["failed"], answered, streak["runs"],
                                 streak["since"]),
            STREAK_TAGS, dry_run=dry_run)
        if streak_paged:
            record["fallback_streak"]["paged"] = True
            record["pages"] += 1
    if verbose:
        print(f"dns-watch: {state_word} ({reason}) — "
              f"{'paged' if should else 'silent'}", file=sys.stderr)
        if streak_should:
            print(f"dns-watch: fallback streak {streak['runs']} — "
                  f"{'paged' if streak_paged else 'not published'}",
                  file=sys.stderr)

    if not dry_run and not save_state(state_path, record):
        print("dns-watch: verdict not recorded — the next run will page "
              "again", file=sys.stderr)

    # The ledger counts *pages*, not runs: an unchanged verdict writes
    # nothing, which is what makes "two runs with no change" byte-identical.
    if paged and not dry_run:
        line = ledger_line(now, state_word, rc, retry_used(output))
        _, rotated = append_ledger(ledger_file, line, cfg["ledger_max"])
        if rotated and verbose:
            print(f"dns-watch: ledger reached {cfg['ledger_max']} line(s) — "
                  f"rotated to {Path(ledger_file).name}.1", file=sys.stderr)
    if streak_paged and not dry_run:
        # A page that is not a verdict change still belongs in the page
        # ledger (the count of pages is true), under a verdict word of its
        # own, so no reader mistakes it for a changed probe.
        line = ledger_line(now, STREAK_LEDGER_WORD, rc, retry_used(output))
        _, rotated = append_ledger(ledger_file, line, cfg["ledger_max"])
        if rotated and verbose:
            print(f"dns-watch: ledger reached {cfg['ledger_max']} line(s) — "
                  f"rotated to {Path(ledger_file).name}.1", file=sys.stderr)

    # A fallback is the one success that changes nothing downstream: the
    # verdict may be exactly what it was, so no page and no page-ledger line.
    # Without a record of its own it is invisible — so each run that used one
    # writes one countable line naming the endpoint that failed. Rotation is
    # the page ledger's rule, applied to the same cap.
    if failed and not dry_run:
        line = fallback_line(now, failed, answered)
        _, rotated = append_ledger(fallback_file, line, cfg["ledger_max"])
        if verbose:
            print(f"dns-watch: fallback — {', '.join(failed)} failed, "
                  f"{answered_endpoint(output) or 'no named endpoint'} "
                  f"answered (recorded)", file=sys.stderr)
            if rotated:
                print(f"dns-watch: fallback ledger reached "
                      f"{cfg['ledger_max']} line(s) — rotated to "
                      f"{Path(fallback_file).name}.1", file=sys.stderr)

    print(f"dns-watch: {state_word.upper()} — {detail}"
          f"{' (paged)' if should else ''}")
    return 4 if rc is None else rc


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="dns-watch",
        description="Run dns-check hourly; page once per verdict change.",
    )
    ap.add_argument("--config", default=DEFAULT_CONFIG,
                    help=f"KEY=VALUE config (default {DEFAULT_CONFIG})")
    ap.add_argument("--state", default=None,
                    help=f"state file (default {DEFAULT_STATE})")
    ap.add_argument("--ledger", default=None,
                    help=f"page ledger (default {LEDGER_NAME} beside the "
                         "state file)")
    ap.add_argument("--history", action="store_true",
                    help=f"print the ledger's last {HISTORY_HOURS} h, one line "
                         "per page, and the newest run's age, then exit "
                         "(runs no probe)")
    ap.add_argument("--stale", action="store_true",
                    help="print one line on the newest run's age and exit "
                         "0 fresh / 1 stale / 2 unmeasurable (no probe, no "
                         "writes)")
    ap.add_argument("--stale-after", type=_hours, default=None,
                    metavar="HOURS",
                    help="--stale with this limit instead of "
                         f"STALE_AFTER_HOURS ({DEFAULT_STALE_AFTER:g} h)")
    ap.add_argument("--dry-run", action="store_true",
                    help="print the decision; publish and write nothing")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="report the probe's rc and the paging decision")
    args = ap.parse_args(argv)

    cfg = load_config(args.config)
    state_path = os.path.expanduser(args.state) if args.state else cfg["state"]
    ledger_file = ledger_path(cfg, state_path, args.ledger)
    fallback_file = fallback_path(ledger_file)
    if args.stale or args.stale_after is not None:
        limit = args.stale_after if args.stale_after is not None \
            else cfg["stale_after"]
        if args.history:
            print_history(ledger_file, state_path,
                          fallbacks_file=fallback_file)
        return stale_verdict(state_path, limit)
    if args.history:
        return print_history(ledger_file, state_path,
                             fallbacks_file=fallback_file)
    return run(cfg, state_path, dry_run=args.dry_run, verbose=args.verbose,
               ledger_file=ledger_file, fallback_file=fallback_file)


if __name__ == "__main__":
    sys.exit(main())
