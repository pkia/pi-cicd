[Unit]
Description=Loop heartbeat - dead-man's switch for scheduled jobs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ev
# hermes lives in ~/.local/bin; systemd units get a minimal PATH by default
Environment=PATH=/home/ev/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ev/.local/bin/loop-heartbeat
