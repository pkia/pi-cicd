def _state_path():
    # $PI_DOCTOR_STATE points the ledger elsewhere — used by the tests and
    # by a manual replay, so neither can touch the live state file.
    return os.environ.get("PI_DOCTOR_STATE") or STATE_PATH


def load_state():
    try:
        with open(_state_path()) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(s):
    try:
        with open(_state_path(), "w") as f:
            json.dump(s, f, indent=1)
    except OSError:
        pass


