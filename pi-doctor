def _sat_capture_running() -> bool:
    try:
        with open("/home/ev/maritime-dashboard/noaa_state.json") as f:
            return json.load(f).get("capture_in_progress", False)
    except (OSError, ValueError):
        return False


def run(cmd, timeout=60):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 124, str(e)


def _dns_resolves(host="example.com") -> bool:
    """Minimal A-record query against 127.0.0.1:53 (no dig dependency)."""
    import socket, struct
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(4)
        q = b"".join(bytes([len(p)]) + p.encode() for p in host.split(".")) + b"\x00"
        s.sendto(struct.pack(">HHHHHH", 0x1234, 0x0100, 1, 0, 0, 0) + q
                 + struct.pack(">HH", 1, 1), ("127.0.0.1", 53))
        data, _ = s.recvfrom(4096)
        s.close()
        return len(data) > 12 and (data[3] & 0x0F) == 0 and (data[7] > 0)
    except (OSError, struct.error):
        return False


def http_json(url, timeout=8):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.status, r.read(8192).decode("utf-8", "replace")
    except Exception as e:
        return None, f"{type(e).__name__}: {e}"


# ---------------------------------------------------------------- projects

def check_project(svc, pdir, ui, healthz, has_deploy, has_ci):
    findings = []
    fixes = []

    # 1. service state + flap detection
    rc, active = run(["systemctl", "is-active", svc])
    if rc != 0:
        # F1: unit exists but dead -> try revive
        if os.path.exists(f"/etc/systemd/system/{svc}.service"):
            run(["systemctl", "reset-failed", svc])
            rc2, _ = run(["systemctl", "start", svc], timeout=90)
            time.sleep(3)
            rc3, _ = run(["systemctl", "is-active", svc])
            if rc3 != 0:
                # Re-check after a delay: SDR-sharing scripts (noaa capture,
                # sdr-monitor) stop/start ais-catcher on their own cycles and
                # can race the revive above, leaving it briefly "inactive".
                time.sleep(10)
                rc3, _ = run(["systemctl", "is-active", svc])
            if rc3 == 0:
                fixes.append(f"revived dead service {svc}")
            else:
                findings.append(f"svc:{svc}:dead — start failed, unit exists")
        elif svc not in NO_UNIT_OK:
            findings.append(f"svc:{svc}:nounit — no unit file found")
    rc, nrst = run(["systemctl", "show", svc, "-p", "NRestarts", "--value"])
    if rc == 0 and nrst.isdigit() and int(nrst) > 20:
        findings.append(f"svc:{svc}:flapping — {nrst} restarts, crash-looping")

    # 2. HTTP checks (skip when the project's own context says so)
    skip = SKIP_HTTP_WHEN.get(svc)
    if not (skip and skip()):
        if healthz:
            st, body = http_json(healthz)
            if st is None:
                findings.append(f"http:{svc}:healthz-down ({body})")
            elif '"healthy"' in body and '"healthy":true' not in body:
                findings.append(f"http:{svc}:selfhealer-unhealthy")
        if ui and st_ok(ui) is False:
            findings.append(f"http:{svc}:ui-down")

    # 3/4/5. repo + CI (skip if no .git — some dirs are shared)
    gdir = pdir if os.path.isdir(os.path.join(pdir, ".git")) else None
    if gdir:
        rc, head = run(["git", "-C", gdir, "rev-parse", "HEAD"])
        rc, dirty = run(["git", "-C", gdir, "status", "--porcelain"])
        if dirty:
            findings.append(f"git:{svc}:dirty-tree — uncommitted local edits")
        if has_deploy:
            marker = os.path.join(gdir, ".deployed_commit")
            running = open(marker).read().strip() if os.path.exists(marker) else ""
            if running and running != head:
                # F2: deploy pipeline stalled -> run deploy.sh once
                dsh = os.path.join(gdir, "deploy", "deploy.sh")
                if os.path.exists(dsh):
                    rc, out = run(["bash", dsh], timeout=300)
                    running2 = open(marker).read().strip() if os.path.exists(marker) else ""
                    if running2 == run(["git", "-C", gdir, "rev-parse", "HEAD"])[1]:
                        fixes.append(f"re-ran deploy for {svc} (was drifted)")
                    else:
                        findings.append(f"deploy:{svc}:stalled — deploy.sh failed")
    if has_ci and gdir:
        rc, remote = run(["git", "-C", gdir, "remote", "get-url", "origin"])
        if rc == 0 and "pkia" in remote:
            m = re.search(r"pkia[/:]([\w.-]+?)(?:\.git)?$", remote)
            if m:
                repo = m.group(1)
                rc, out = run(["gh", "run", "list", "-R", f"pkia/{repo}",
                               "--limit", "1", "--json", "conclusion"], 60)
                try:
                    concl = json.loads(out)[0]["conclusion"]
                    if concl not in ("success", None):
                        findings.append(f"ci:{repo}:red — last run {concl}")
                except (json.JSONDecodeError, IndexError, KeyError):
                    pass

    return findings, fixes


def st_ok(url):
    st, _ = http_json(url)
    return None if st is None else st == 200


# ---------------------------------------------------------------- system

def check_system():
    findings, fixes = [], []

    st = os.statvfs("/")
    pct = (1 - st.f_bavail / st.f_blocks) * 100
    if pct > 90:
        findings.append(f"sys:disk {pct:.0f}% full")
    elif pct > 80:
        # safe fix: clear apt/journal caches
        before = pct
        run(["sudo", "-n", "journalctl", "--vacuum-size=200M"])
        st2 = os.statvfs("/")
        pct2 = (1 - st2.f_bavail / st2.f_bblocks) * 100 if hasattr(st2, "f_bblocks") else pct
        if pct2 < before - 0.5:
            fixes.append(f"journal vacuum freed disk ({before:.0f}% -> {pct2:.0f}%)")

    try:
        t = int(open("/sys/class/thermal/thermal_zone0/temp").read()) / 1000
        if t > 80:
            findings.append(f"sys:cpu-temp {t:.0f}C")
    except (OSError, ValueError):
        pass

    rc, out = run(["free", "-m"])
    m = re.search(r"Mem:\s+(\d+)\s+(\d+)", out or "")
    if m and int(m.group(2)) / int(m.group(1)) > 0.95:
        findings.append(f"sys:mem {m.group(2)}/{m.group(1)}MB used >95%")

    rc, out = run(["systemctl", "--failed", "--no-legend"])
    if out:
        for line in out.splitlines():
            findings.append(f"sys:failed-unit {line.split()[0]}")

    # AdGuard DNS actually resolving (raw UDP query, stdlib only)
    if not _dns_resolves():
        run(["systemctl", "restart", "AdGuardHome"], 90)
        time.sleep(5)
        if _dns_resolves():
            fixes.append("restarted AdGuardHome (DNS not resolving)")
        else:
            findings.append("sys:adguard-dns down even after restart")

    # rpi-connect leak guard
    rc, out = run(["pgrep", "-f", "rpi-connectd", "-o"])
    pid = (out or "").splitlines()[0] if out else ""
    if pid:
        rc, rss = run(["ps", "-o", "rss=", "-p", pid])
        if rss.isdigit() and int(rss) > 2_500_000:
            run(["systemctl", "restart", "rpiconnect"], 90)
            fixes.append("restarted rpi-connect (RSS > 2.5GB leak)")

    return findings, fixes


# ---------------------------------------------------------------- sdr

def check_sdr():
    """Detect a wedged RTL-SDR dongle and revive it with USBDEVFS_RESET.

    Wedge signature (seen 2026-08-27, since ~Aug 23 for rtl_power): the
    dongle enumerates and the USB claim succeeds, but zero samples flow —
    ais-catcher logs 'RTLSDR: timeout' ~40x/min forever, rtl_power/rtl_sdr
    produce nothing, NOAA captures fail 'could not open SDR'. A USB protocol
    reset (not sysfs authorize toggling — that does NOT clear it) restores
    the stream. Skipped during satellite captures (SDR handed to NOAA)."""
    findings, fixes = [], []

    rc, _ = run(["systemctl", "is-active", "ais-catcher"])
    if rc != 0 or _sat_capture_running():
        return findings, fixes
    rc, out = run(["journalctl", "-u", "ais-catcher", "--since", "-10 min",
                   "--no-pager", "-q"])
    timeouts = sum(1 for l in (out or "").splitlines()
                   if "RTLSDR: timeout" in l)
    if timeouts < 30:      # wedged ≈ 400/10min; scan blips are single digits
        return findings, fixes

    if _sdr_usb_reset():
        time.sleep(20)     # let ais-catcher re-attach and stream (or not)
        rc, pid = run(["systemctl", "show", "ais-catcher",
                       "-p", "MainPID", "--value"])
        if pid.isdigit():
            rc, out = run(["journalctl", "-u", "ais-catcher", "_PID=" + pid,
                           "--no-pager", "-q"])
            still = sum(1 for l in (out or "").splitlines()
                        if "RTLSDR: timeout" in l)
        else:
            still = 1        # couldn't verify — be conservative
        if still == 0:
            fixes.append(f"un-wedged RTL-SDR via USB reset "
                         f"({timeouts} timeouts/10min)")
        else:
            findings.append("sys:sdr-wedged — USB reset did not restore stream")
    else:
        findings.append("sys:sdr-wedged — USBDEVFS_RESET failed, "
                        "needs physical replug")
    return findings, fixes


def _sdr_usb_reset() -> bool:
    """USBDEVFS_RESET the 0bda:2838 dongle, restarting both consumers."""
    import fcntl
    rc, out = run(["lsusb"])
    path = None
    for line in (out or "").splitlines():
        m = re.match(r"Bus (\d+) Device (\d+): ID 0bda:2838", line)
        if m:
            path = f"/dev/bus/usb/{int(m.group(1)):03d}/{int(m.group(2)):03d}"
    if not path or not os.path.exists(path):
        return False
    run(["sudo", "-n", "systemctl", "stop", "sdr-monitor", "ais-catcher"], 90)
    time.sleep(2)
    try:
        fd = os.open(path, os.O_WRONLY)
        try:
            fcntl.ioctl(fd, 21780, 0)     # USBDEVFS_RESET
        finally:
            os.close(fd)
    except OSError:
        run(["sudo", "-n", "systemctl", "start", "ais-catcher",
             "sdr-monitor"], 90)
        return False
    time.sleep(3)
    run(["sudo", "-n", "systemctl", "start", "ais-catcher", "sdr-monitor"], 90)
    return True


# ---------------------------------------------------------------- reporting

def load_state():
    try:
        with open(STATE_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(s):
    try:
        with open(STATE_PATH, "w") as f:
            json.dump(s, f, indent=1)
    except OSError:
        pass


def send_alert(subject, body):
    """WhatsApp via hermes send + ntfy backup channel."""
    run(["hermes", "send", "--to", "whatsapp:8087473803462@lid",
         "--message", f"{subject}: {body}"], 30)
    try:
        import urllib.request
        req = urllib.request.Request(
            "http://100.122.94.33:6839/loop-heartbeat",
            data=body.encode(),
            headers={"Title": subject,
                     "Authorization": "Bearer " + _ntfy_token()})
        urllib.request.urlopen(req, timeout=8)
    except Exception:
        pass


def _ntfy_token():
    for p in ("/etc/ntfy-notify.conf", "/etc/loop-heartbeat.conf"):
        try:
            for line in open(p):
                if line.startswith("NTFY_TOKEN"):
                    return line.split("=", 1)[1].strip()
        except OSError:
            continue
    return ""


def main():
    verbose = "--verbose" in sys.argv
    now = datetime.now()
    all_findings, all_fixes = [], []

    for entry in PROJECTS:
        svc, pdir, ui, healthz, has_deploy, has_ci = entry[:6]
        try:
            f, x = check_project(svc, pdir, ui, healthz, has_deploy, has_ci)
            all_findings += f
            all_fixes += x
        except Exception as e:
            all_findings.append(f"doctor:{svc}:check-error {type(e).__name__}: {e}")
    try:
        f, x = check_system()
        all_findings += f
        all_fixes += x
    except Exception as e:
        all_findings.append(f"doctor:system:check-error {type(e).__name__}: {e}")
    try:
        f, x = check_sdr()
        all_findings += f
        all_fixes += x
    except Exception as e:
        all_findings.append(f"doctor:sdr:check-error {type(e).__name__}: {e}")

    report = format_report(all_findings, all_fixes, now)
    if verbose:
        print(report)

    if all_findings:
        state = load_state()
        new = [f for f in all_findings if _key(f) not in state or
               (now - datetime.fromisoformat(state[_key(f)])).total_seconds()
               > ALERT_EVERY_H * 3600]
        for f in new:
            state[_key(f)] = now.isoformat(timespec="seconds")
        save_state(state)
        if new:
            send_alert("⚠ pi-doctor", report)
    elif all_fixes:
        send_alert("🔧 pi-doctor", "auto-fixed without issue:\n" +
                   "\n".join(f"- {x}" for x in all_fixes))
    # all green and nothing fixed -> silent

    return 0


def _key(finding):
    return finding.split(" — ")[0].split(" (")[0].strip()


def format_report(findings, fixes, now):
    now = now or datetime.now()
    lines = [f"pi-doctor daily audit — {now:%Y-%m-%d %H:%M}", ""]
    if fixes:
        lines.append("Auto-fixed:")
        lines += [f"  ✓ {x}" for x in fixes]
    if findings:
        lines.append("Needs attention:")
        lines += [f"  ⚠ {f}" for f in findings]
    if not fixes and not findings:
        lines.append("All projects healthy.")
    return "\n".join(lines)


if __name__ == "__main__":
    sys.exit(main())
